<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Weather App</title>
    <link rel="stylesheet" href="/styles.css">
</head>

<body>
    <div class="container">
        <div class="search-card">
            <h1>Weather App</h1>
            <form action="/" method="post">
                <input type="text" name="city" placeholder="City" required>
                <button type="submit">Search</button>
            </form>
        </div>

        <% if(error){ %>
            <div class="error">
                <%= error %>
            </div>
            <% } %>

                <% if(data){ %>
                    <div class="weather-card">
                        <div class="hero">
                            <img src="<%= heroImage %>" class="hero-image">
                            <div class="overlay">
                                <div class="top">
                                    <h3>
                                        <%= new Date().toLocaleTimeString([], { hour: '2-digit' , minute: '2-digit' })
                                            %>
                                    </h3>
                                </div>
                                <div class="bottom">
                                    <div class="left">
                                        <h1>
                                            <%= Math.round(data.main.temp) %>°
                                        </h1>
                                    </div>
                                    <div class="right">
                                        <h2>
                                            <%= data.weather[0].description %>
                                        </h2>
                                        <p>Feels like <%= Math.round(data.main.temp) %>°</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="details">
                            <div class="box">
                                <h4>wind</h4>
                                <p>
                                    <%= data.wind.speed %> m/s SSW
                                </p>
                            </div>
                            <div class="box">
                                <h4>humidity</h4>
                                <p>
                                    <%= data.main.humidity %> %
                                </p>
                            </div>
                            <div class="box">
                                <h4>pressure</h4>
                                <p>
                                    <%= data.main.pressure %> hpa
                                </p>
                            </div>
                            <div class="box">
                                <h4>visibility</h4>
                                <p>
                                    <%= data.visibility %> meters
                                </p>
                            </div>
                            <div class="box">
                                <h4>sunrise</h4>
                                <p>
                                    <%= data.sys.sunrise %>
                                </p>
                            </div>
                            <div class="box">
                                <h4>sunset</h4>
                                <p>
                                    <%= data.sys.sunset %>
                                </p>
                            </div>
                        </div>


                    </div>
                    <% } %>

    </div>
</body>

</html>